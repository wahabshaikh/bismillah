# Bismillah — local dev secrets (placeholder names only).
# Copy to `.dev.vars` and fill in. NEVER commit `.dev.vars`.
# In production set each with: npx wrangler secret put <NAME>
#
# Every value is OPTIONAL — features degrade to demo mode when unset:
#   - email is logged instead of sent
#   - checkout / portal return a 503 hint
#   - Google button shows an "unavailable" message

# --- Site ---
NEXT_PUBLIC_SITE_URL="http://localhost:5173"

# --- Better Auth ---
BETTER_AUTH_SECRET="generate-a-32+-char-random-string"
BETTER_AUTH_URL="http://localhost:5173"

# --- Google OAuth (omit both to hide the Google button) ---
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Plunk (transactional email) ---
PLUNK_API_KEY="sk_..."
PLUNK_FROM_EMAIL="hello@yourdomain.com"

# --- Polar (halal one-time payments) ---
POLAR_ACCESS_TOKEN="polar_pat_..."
POLAR_PRODUCT_ID="your-one-time-product-id"
POLAR_SUBSCRIPTION_PRODUCT_ID=""
POLAR_WEBHOOK_SECRET="whsec_..."
POLAR_SERVER="sandbox"

# --- P1: bring-your-own AI key encryption (optional; falls back to BETTER_AUTH_SECRET) ---
AI_KEYS_ENCRYPTION_SECRET=""

# --- P1: privacy-friendly analytics (no-op unless provider + id set) ---
# provider is "plausible" or "datafast"
NEXT_PUBLIC_ANALYTICS_PROVIDER=""
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=""
NEXT_PUBLIC_DATAFAST_WEBSITE_ID=""
NEXT_PUBLIC_DATAFAST_DOMAIN=""

# --- P1: error monitoring (no-op console fallback unless SENTRY_DSN set) ---
SENTRY_DSN=""
SENTRY_ENVIRONMENT="development"

# --- P1: daily digest cron (comma-separated emails; logs only when unset) ---
DIGEST_TO=""

# --- P1: organizations schema flag (tables ship; UI later). "true" to enable ---
ENABLE_ORGS="false"
