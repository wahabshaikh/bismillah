// Shared keys (compatibility date/flags, observability, source maps) come from
// tooling/wrangler/base.jsonc and are enforced by `pnpm check:wrangler`.
//
// Bindings have no resource IDs on purpose: `wrangler dev` and the tests use local
// simulators, and `wrangler deploy` provisions the D1 database, KV namespace, R2
// bucket and queue on first deploy and writes their IDs back into this file.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bismillah-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-15",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "upload_source_maps": true,
  "vars": {
    "APP_NAME": "bismillah",
    // Public URL of this Worker; Better Auth uses it for callbacks and cookies.
    "BETTER_AUTH_URL": "http://localhost:8787",
    // Comma-separated origins allowed to call the API with credentials: the web app, the
    // mobile app's URL scheme and, for local development only, Expo Go (`exp://`).
    "TRUSTED_ORIGINS": "http://localhost:3000,bismillah://,exp://",
    // Largest upload accepted by POST /v1/uploads, in bytes (10 MiB).
    "MAX_UPLOAD_BYTES": "10485760"
  },
  // Set with `wrangler secret put`; locally, copy .dev.vars.example to .dev.vars.
  "secrets": {
    "required": ["BETTER_AUTH_SECRET"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bismillah",
      "migrations_dir": "migrations"
    }
  ],
  // Better Auth sessions (secondary storage) and the read-through cache.
  "kv_namespaces": [
    {
      "binding": "KV"
    }
  ],
  "r2_buckets": [
    {
      "binding": "UPLOADS",
      "bucket_name": "bismillah-uploads"
    }
  ],
  // Background jobs (src/jobs/). The same Worker produces and consumes: routes enqueue
  // with `enqueue(env, job)`, and `queue()` in src/index.ts runs them in batches.
  "queues": {
    "producers": [
      {
        "binding": "JOBS",
        "queue": "bismillah-jobs"
      }
    ],
    "consumers": [
      {
        "queue": "bismillah-jobs",
        // Up to 10 messages per invocation, or whatever arrived within 5 seconds.
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        // After 3 failed attempts a message is dropped; the hourly sweep in
        // src/jobs/scheduled.ts re-enqueues anything that was never processed.
        "max_retries": 3
      }
    ]
  },
  // Cron Triggers are free. Times are UTC; see src/jobs/scheduled.ts.
  "triggers": {
    "crons": ["0 * * * *"]
  },
  // One UserEvents object per user fans realtime events out to that user's open
  // WebSockets (src/realtime/). SQLite-backed classes are the default for new objects.
  "durable_objects": {
    "bindings": [
      {
        "name": "USER_EVENTS",
        "class_name": "UserEvents"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["UserEvents"]
    }
  ],
  // Workers Rate Limiting is free on every plan and keeps brute-force traffic off D1.
  "ratelimits": [
    {
      "name": "AUTH_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 10, "period": 60 }
    }
  ]
}
