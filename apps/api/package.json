{
  "name": "@bismillah/api",
  "version": "0.0.0",
  "private": true,
  "description": "API Worker: Hono, D1 + Drizzle, Better Auth, KV and R2.",
  "license": "MIT",
  "type": "module",
  "exports": {
    "./app": {
      "types": "./dist/types/app.d.ts"
    }
  },
  "scripts": {
    "dev": "pnpm db:migrate:local && node scripts/dev.ts",
    "deploy": "pnpm db:migrate:remote && wrangler deploy",
    "typegen": "wrangler types",
    "types": "tsc -p tsconfig.types.json",
    "typecheck": "tsc",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@bismillah/core": "workspace:*",
    "@hono/zod-validator": "0.9.1",
    "better-auth": "catalog:",
    "drizzle-orm": "0.45.3",
    "hono": "catalog:",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@bismillah/tsconfig": "workspace:*",
    "@cloudflare/vitest-pool-workers": "catalog:",
    "@types/node": "catalog:",
    "drizzle-kit": "0.31.11",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  }
}
