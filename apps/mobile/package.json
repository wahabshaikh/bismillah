{
  "name": "@bismillah/mobile",
  "version": "0.0.0",
  "private": true,
  "description": "Mobile app: Expo (React Native) for iOS and Android, talking to the API Worker over typed RPC.",
  "license": "MIT",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "ios": "expo start --ios",
    "android": "expo start --android",
    "build": "expo export --platform ios --platform android",
    "typecheck": "tsc",
    "test": "vitest run"
  },
  "dependencies": {
    "@better-auth/expo": "catalog:",
    "@bismillah/api-client": "workspace:*",
    "@tanstack/react-query": "5.104.0",
    "better-auth": "catalog:",
    "expo": "~57.0.26",
    "expo-constants": "~57.0.20",
    "expo-document-picker": "~57.0.3",
    "expo-file-system": "~57.0.7",
    "expo-linking": "~57.0.11",
    "expo-network": "~57.0.2",
    "expo-router": "~57.0.24",
    "expo-secure-store": "~57.0.4",
    "expo-sharing": "~57.0.22",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-web-browser": "~57.0.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-worklets": "0.10.1"
