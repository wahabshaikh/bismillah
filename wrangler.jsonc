{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bismillah",
  "compatibility_date": "2026-09-10",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "./worker/index.ts",
  "preview_urls": true,
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS",
    "run_worker_first": ["/agents/*"]
  },
  "cache": {
    "enabled": true
  },
  "ai": {
    "binding": "AI",
    "remote": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bismillah",
      "database_id": "36a267af-1bd7-4da0-af68-95654c6d46c3",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "ARTIFACTS",
      "bucket_name": "bismillah-artifacts"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "2423ae5f6f90406d8a2233680c5d1c26"
    },
    {
      "binding": "VINEXT_KV_CACHE",
      "id": "02cf4b23eb084760b4fd0e755bbd6e96"
    }
  ],
  "ratelimits": [
    {
      "name": "RATE_LIMITER_8",
      "namespace_id": "19891208",
      "simple": { "limit": 8, "period": 60 }
    },
    {
      "name": "RATE_LIMITER_10",
      "namespace_id": "19891210",
      "simple": { "limit": 10, "period": 60 }
    },
    {
      "name": "RATE_LIMITER_12",
      "namespace_id": "19891212",
      "simple": { "limit": 12, "period": 60 }
    },
    {
      "name": "RATE_LIMITER_20",
      "namespace_id": "19891220",
      "simple": { "limit": 20, "period": 60 }
    },
    {
      "name": "RATE_LIMITER_30",
      "namespace_id": "19891230",
      "simple": { "limit": 30, "period": 60 }
    },
    {
      "name": "RATE_LIMITER_60",
      "namespace_id": "19891260",
      "simple": { "limit": 60, "period": 60 }
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "class_name": "ChatAgent",
        "name": "ChatAgent"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["ChatAgent"]
    }
  ],
  "triggers": {
    "crons": ["0 9 * * *"]
  }
}
